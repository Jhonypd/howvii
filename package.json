{
  "name": "how-vii",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de relatórios de pagamentos imobiliários para o Hands on Work VII",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "consulta": "tsx src/cli/consulta.ts",
    "start": "npm run build && node dist/src/server.js",
    "test": "npm run build && node --test test/unit/*.test.js test/http/*.test.js test/contract/*.test.js",
    "test:integracao": "npm run build && node --test integration/sql/*.test.js"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "mssql": "^12.0.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.2",
    "@types/swagger-ui-express": "^4.1.8",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  }
}
